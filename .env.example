# The browser demo needs no credentials.
# Keep authenticated Binance Agent OS credentials outside this repository.

SITE_URL=http://localhost:3000

# Local autonomous daemon. DRY_RUN is the safe default and needs no credentials.
TRENDLOCK_MODE=DRY_RUN
TRENDLOCK_STATE_DIR=.trendlock
TRENDLOCK_POLL_MS=5000
TRENDLOCK_POOL_SIZE=36
TRENDLOCK_MIN_SCORE=90
TRENDLOCK_MAX_SLOTS=2
TRENDLOCK_PORTFOLIO_RISK_PCT=10
TRENDLOCK_PER_SLOT_RISK_PCT=5
TRENDLOCK_LEVERAGE=3
TRENDLOCK_INITIAL_STOP_PCT=7
TRENDLOCK_MAX_ENTRY_DRIFT_PCT=1
TRENDLOCK_MAX_DAILY_DRAWDOWN_PCT=10
TRENDLOCK_MAX_CONSECUTIVE_LOSSES=2
TRENDLOCK_MIN_TURNOVER=20000000
TRENDLOCK_MAX_SPREAD_BPS=8
TRENDLOCK_MIN_VOLUME_RATIO=1.2

# Optional comma-separated allowlist. Blank means the scanner's eligible universe.
TRENDLOCK_ALLOWED_SYMBOLS=

# TESTNET/LIVE only. Put values in an untracked local .env or your process manager,
# never in this file, source control, screenshots, chat, or browser storage.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Fill the two variables above only in your local untracked environment.
# LIVE additionally requires this exact unlock:
# TRENDLOCK_LIVE_ACK=I_ACCEPT_AUTONOMOUS_FUTURES_RISK
